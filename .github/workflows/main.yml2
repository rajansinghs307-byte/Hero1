name: RDP

on:
  workflow_dispatch:

jobs:
  secure-rdp:
    runs-on: windows-latest
    timeout-minutes: 360   # GitHub-hosted runners ka max 6 ghante hai

    defaults:
      run:
        shell: pwsh

    steps:
      - name: Configure Core RDP Settings
        run: |
          $ts = 'HKLM:\System\CurrentControlSet\Control\Terminal Server'
          $rdp = "$ts\WinStations\RDP-Tcp"

          # Remote Desktop ON, NLA OFF
          Set-ItemProperty -Path $ts  -Name "fDenyTSConnections" -Value 0 -Force
          Set-ItemProperty -Path $rdp -Name "UserAuthentication" -Value 0 -Force
          Set-ItemProperty -Path $rdp -Name "SecurityLayer"      -Value 0 -Force

          # Firewall: sirf Tailscale network (100.64.0.0/10) se RDP allow
          Remove-NetFirewallRule -DisplayName "RDP-Tailscale" -ErrorAction SilentlyContinue
          New-NetFirewallRule -DisplayName "RDP-Tailscale" -Direction Inbound `
            -Action Allow -Protocol TCP -LocalPort 3389 -RemoteAddress 100.64.0.0/10 | Out-Null

          # NOTE: TermService restart jaan-bujhke nahi kiya, wo runner pe hang ho jaata hai.
          # Naye RDP connections pe registry changes apne aap lag jaate hain.
          Write-Host "RDP settings done."

      - name: Create RDP User with Secure Password
        run: |
          $upper   = [char[]](65..90)
          $lower   = [char[]](97..122)
          $number  = [char[]](48..57)
          $special = [char[]]"!@#$%^&*-_=+"

          $chars  = @()
          $chars += $upper   | Get-Random -Count 5
          $chars += $lower   | Get-Random -Count 5
          $chars += $number  | Get-Random -Count 4
          $chars += $special | Get-Random -Count 3
          $password = -join ($chars | Sort-Object { Get-Random })

          $securePass = ConvertTo-SecureString $password -AsPlainText -Force
          New-LocalUser -Name "RDP" -Password $securePass -AccountNeverExpires | Out-Null
          Add-LocalGroupMember -Group "Administrators" -Member "RDP"
          Add-LocalGroupMember -Group "Remote Desktop Users" -Member "RDP"

          if (-not (Get-LocalUser -Name "RDP" -ErrorAction SilentlyContinue)) {
              Write-Error "User creation failed"
              exit 1
          }

          "RDP_PASSWORD=$password" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8
          Write-Host "User RDP created."

      - name: Install Tailscale
        run: |
          $tsUrl = "https://pkgs.tailscale.com/stable/tailscale-setup-1.82.0-amd64.msi"
          $installerPath = Join-Path $env:RUNNER_TEMP "tailscale-setup.msi"

          Invoke-WebRequest -Uri $tsUrl -OutFile $installerPath
          $p = Start-Process msiexec.exe -ArgumentList "/i", "`"$installerPath`"", "/quiet", "/norestart" -Wait -PassThru
          Remove-Item $installerPath -Force -ErrorAction SilentlyContinue

          if ($p.ExitCode -notin 0, 3010) {
              Write-Error "Tailscale install failed, exit code $($p.ExitCode)"
              exit 1
          }
          Write-Host "Tailscale installed."

      - name: Establish Tailscale Connection
        env:
          TS_AUTHKEY: ${{ secrets.TAILSCALE_AUTH_KEY }}
        run: |
          $tsExe = Join-Path $env:ProgramFiles "Tailscale\tailscale.exe"

          # Service chalu hone tak wait (max ~60s)
          for ($i = 0; $i -lt 12; $i++) {
              $svc = Get-Service -Name "Tailscale" -ErrorAction SilentlyContinue
              if ($svc -and $svc.Status -eq "Running") { break }
              Start-Sleep -Seconds 5
          }

          & $tsExe up --authkey=$env:TS_AUTHKEY --hostname="gh-runner-$env:GITHUB_RUN_ID" --unattended --accept-dns=false

          # IP assign hone tak wait
          $tsIP = $null
          for ($i = 0; $i -lt 12 -and -not $tsIP; $i++) {
              $tsIP = (& $tsExe ip -4 2>$null | Select-Object -First 1)
              if (-not $tsIP) { Start-Sleep -Seconds 5 }
          }

          if (-not $tsIP) {
              Write-Error "Tailscale IP assign nahi hua. TAILSCALE_AUTH_KEY check karo."
              exit 1
          }

          "TAILSCALE_IP=$tsIP" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8
          Write-Host "Tailscale IP: $tsIP"

      - name: Verify RDP Accessibility
        run: |
          $ok = $false
          for ($i = 0; $i -lt 5 -and -not $ok; $i++) {
              $r = Test-NetConnection -ComputerName $env:TAILSCALE_IP -Port 3389 -WarningAction SilentlyContinue
              $ok = $r.TcpTestSucceeded
              if (-not $ok) { Start-Sleep -Seconds 5 }
          }
          if ($ok) { Write-Host "RDP port 3389 reachable." }
          else     { Write-Warning "Port test fail hua, phir bhi session chalu rakh rahe hain." }

      - name: Maintain Connection
        run: |
          Write-Host ""
          Write-Host "=== RDP ACCESS ==="
          Write-Host "Address : $env:TAILSCALE_IP"
          Write-Host "Username: RDP"
          Write-Host "Password: $env:RDP_PASSWORD"
          Write-Host "=================="
          Write-Host ""

          # Runner tab tak zinda jab tak cancel na karo (ya 6 ghante)
          while ($true) {
              Write-Host "[$(Get-Date -Format 'HH:mm:ss')] RDP active  ->  $env:TAILSCALE_IP"
              Start-Sleep -Seconds 300
          }
